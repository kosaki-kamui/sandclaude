# Required: Your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional: API server port (default: 3271)
PORT=3271

# Optional: Runtime environment: production | development | dev | test (default: production)
# ENVIRONMENT=production

# Optional: Max task duration in seconds (default: 1800 = 30 min)
TASK_TIMEOUT_S=1800

# Optional: Max concurrent runners (default: 3)
MAX_CONCURRENT=3

# IMPORTANT: sandclaude must run as a single uvicorn worker (the default).
# Pool scheduling, rate limiting, and background task state are process-local.
# Do NOT set WEB_CONCURRENCY > 1 or use --workers > 1.

# Optional: Data directory for SQLite DB, task results, auth token (default: ./data)
# DATA_DIR=./data

# Optional: Host working directory for local repo mode (repo=".")
# Normally auto-detected; set explicitly when API server runs inside Docker
# HOST_CWD=/home/user/project

# Optional: Public URL for generic (non-Slack) webhook payloads (default: http://localhost:3271)
# Slack notifications include the diff inline and do not use this URL.
# API_URL=https://your-server.example.com:3271

# Optional: Additional bearer tokens (comma-separated) for multi-client access
# AUTH_TOKENS=token1,token2

# Optional: Domains the agent can access during execution (comma-separated)
# These are added to iptables allow rules alongside api.anthropic.com.
# Useful for letting Claude install dependencies from package registries.
# ALLOWED_DOMAINS=registry.npmjs.org,pypi.org,files.pythonhosted.org

# Optional: Auto-delete terminal tasks (completed/failed/cancelled)
# older than N days on startup (default: 30, 0 = keep forever)
# TASK_RETENTION_DAYS=30

# Optional: Skip network isolation (for development/debugging only).
# Ignored/refused unless ENVIRONMENT is development or test.
# SKIP_NETWORK_ISOLATION=false

# Optional: Restrict local repo mounts to specific base directories (comma-separated).
# If unset, production mode requires HOST_CWD to be set for local repos.
# ALLOWED_REPO_BASE=/home/user/projects,/opt/repos

# Optional: Include task prompt excerpt in webhook payloads (default: false).
# When false, prompts are omitted from webhook data to prevent leaking
# sensitive project details to third-party endpoints (e.g., Slack).
# WEBHOOK_INCLUDE_PROMPT=false

# Optional: Git token for cloning private repos + creating PRs.
# - Cloning: works with any HTTPS git host (GitHub, GitLab, Bitbucket, etc.) via GIT_ASKPASS.
# - PR creation: GitHub only (token is passed as GH_TOKEN to the gh CLI).
# Scrubbed before the agent phase starts — Claude never sees it.
# For GitHub: create a fine-grained PAT with Contents: Read+Write and Pull requests: Read+Write.
# GIT_TOKEN=github_pat_...

# Optional: Injectable secrets for tasks.
# Tasks declare which secrets they need via the declared_secrets field.
# The server resolves them from these env vars per policy preset.
# Secret names are recorded in the audit log; values are never logged.
# SECRET_NPM_TOKEN=npm_abc123
# SECRET_DATABASE_URL=postgres://user:pass@host/db

# ── v0.3.0: GitHub OAuth for Approval UI ──────────────────────────────
# Optional: Enable browser-based GitHub login for the approval UI.
# Create a GitHub OAuth App at https://github.com/settings/developers
# Set the callback URL to: {API_URL}/auth/github/callback
# GITHUB_CLIENT_ID=your_client_id
# GITHUB_CLIENT_SECRET=your_client_secret

# ── v0.4.0: Sandbox Security ──────────────────────────────────────────
# Optional: Container sandbox profile (default: standard)
# - standard: NET_ADMIN dropped after iptables rules applied
# - strict:   standard + read-only root filesystem + no-new-privileges
# In production, "strict" is recommended for defense in depth.
# SANDBOX_MODE=standard

# Optional: How often to re-resolve allowed_domains IPs during agent execution (default: 300s).
# Prevents CDN/IP rotation from breaking long-running tasks.
# Set to 0 to disable refresh entirely.
# EGRESS_REFRESH_INTERVAL_S=300

# ── IMPORTANT: TLS / HTTPS ─────────────────────────────────────────────
# sandclaude's API server runs plain HTTP. In production, you MUST put it
# behind a TLS-terminating reverse proxy (nginx, Caddy, Traefik, etc.)
# to protect bearer tokens in transit. Example with Caddy:
#
#   your-server.example.com {
#     reverse_proxy localhost:3271
#   }
#
# Then set API_URL to the public HTTPS URL:
# API_URL=https://your-server.example.com
